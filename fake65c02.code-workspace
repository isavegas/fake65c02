{
  "folders": [
    {
      "path": ".",
    },
  ],
  "extensions": {
    "recommendations": [
      "gruntfuggly.todo-tree",
      "mesonbuild.mesonbuild",
      "llvm-vs-code-extensions.vscode-clangd",
    ],
  },
  "settings": {
    "C_Cpp.default.compileCommands": "c:\\Projects\\C\\fake65c02\\build/compile_commands.json",
    "C_Cpp.default.configurationProvider": "mesonbuild.mesonbuild",
    "mesonbuild.buildFolder": "build",
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "type": "meson",
        "mode": "build",
        "problemMatcher": ["$meson-gcc"],
        "group": {
          "kind": "build",
          "isDefault": true,
        },
        "label": "Meson: Build all targets",
      },
    ],
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "fake65c02.exe",
        "type": "lldb",
        "request": "launch",
        "program": "${workspaceFolder}/build/fake65c02.exe",
      },
      {
        "name": "fake65c02_gui.exe",
        "type": "lldb",
        "request": "launch",
        "program": "${workspaceFolder}/build/fake65c02_gui.exe",
      },
    ],
  },
}
